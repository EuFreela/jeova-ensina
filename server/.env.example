# Porta do servidor
PORT=3001

# Ambiente: development | production | test
NODE_ENV=development

# Segredo usado para assinar o JWT (TROQUE EM PRODUCAO)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Banco de dados
# SQLite (dev): ./database.sqlite
# PostgreSQL (producao): postgres://user:senha@host:5432/adivinhacao
DATABASE_DIALECT=sqlite
DATABASE_STORAGE=./database.sqlite

# Origens liberadas no CORS (frontend), separadas por virgula.
# Aceita curinga no host, ex.: http://192.168.*:5173
# Em desenvolvimento a rede local (localhost, 10.x, 172.16-31.x, 192.168.x,
# *.local) e liberada automaticamente, para o jogo abrir pelo celular.
# Em producao isso e DESLIGADO: so valem as origens listadas em CLIENT_URL.
# CORS_LAN=true/false  ->  liga/desliga a liberacao automatica da rede local
# Origem liberada no CORS (frontend)
CLIENT_URL=http://localhost:5173

# Nome do usuario administrador criado por "npm run criar:admin"
ADMIN_USERNAME=admin
