# =====================================================================
# Servidor — copie para server/.env e ajuste.
# O .env nao e versionado. O servidor REFUSA subir se faltar o JWT_SECRET.
# =====================================================================

# Porta do servidor
PORT=3002

# Ambiente: development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------
# Segredo do JWT — OBRIGATORIO, o servidor nao sobe sem ele.
#
# Em desenvolvimento o valor de exemplo abaixo so gera um aviso. Em
# producao o servidor se recusa a subir com ele (ou com menos de 32
# caracteres). Gere o seu com:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Trocar este valor desloga todo mundo: os tokens antigos deixam de assinar.
# ---------------------------------------------------------------------
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# Sobe o mesmo nivel de exigencia do JWT_SECRET sem fingir que e producao.
# Útil em CI e homologacao, que rodam com NODE_ENV=development mas nao
# podem aceitar chave curta. true/false.
EXIGIR_SEGREDO=false

# ---------------------------------------------------------------------
# Banco de dados
# SQLite (dev):     ./data/database.sqlite, dentro de server/data
# PostgreSQL (prod): postgres://user:senha@host:5432/adivinhacao
#
# Com sqlite em NODE_ENV=production o servidor avisa: o arquivo local nao
# e compartilhado entre replicas nem sobrevive a troca de maquina.
# ---------------------------------------------------------------------
DATABASE_DIALECT=sqlite
DATABASE_STORAGE=./data/database.sqlite

# Usados apenas quando DATABASE_DIALECT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=adivinhacao

# ---------------------------------------------------------------------
# CORS — origens liberadas do frontend, separadas por virgula.
# Aceita curinga no host, ex.: http://192.168.*:5173
#
# Em desenvolvimento a rede local (localhost, 10.x, 172.16-31.x, 192.168.x,
# *.local) e liberada automaticamente, para o jogo abrir pelo celular.
# Em producao isso e DESLIGADO: so valem as origens listadas em CLIENT_URL.
# CORS_LAN=true/false  ->  liga/desliga a liberacao automatica da rede local
# ---------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
CORS_LAN=true

# ---------------------------------------------------------------------
# Proxy reverso (Render, Railway, Vercel, Cloudflare, Nginx...)
#
# OBRIGATORIO em producao atras de proxy. Todos os limiters de requisicao
# contam por `req.ip`: sem isto, todo mundo cai no mesmo contador e uma
# unica pessoa rodando um script trava o acesso de todos. `1` confia no
# primeiro salto (o caso comum de um proxy so na frente).
# ---------------------------------------------------------------------
TRUST_PROXY=0

# ---------------------------------------------------------------------
# Limites de requisicao (por IP, por janela). Ajuste sem mexer no codigo.
# Teto de login, 15 min
# ---------------------------------------------------------------------
LIMITE_LOGIN=20
# Troca de senha e de nome de usuario, 15 min
LIMITE_SENHA=10
# Rotas administrativas (criar/apagar contas), 15 min
LIMITE_ADMIN=60
# Envio de pontuacao, 1 min
LIMITE_PONTUACAO=20
# Demais rotas, 1 min
LIMITE_GERAL=300

# ---------------------------------------------------------------------
# Nome do usuario administrador criado por "npm run criar:admin".
# A senha inicial e sorteada e mostrada uma unica vez, no terminal.
# ---------------------------------------------------------------------
ADMIN_USERNAME=admin
